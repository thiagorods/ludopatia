<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="770.0" prefWidth="864.0" styleClass="main-menu-background" stylesheets="@../css/main-menu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ludopatia.game.controller.MainMenuViewController">
   <children>
      <Pane prefHeight="200.0" prefWidth="200.0" styleClass="overlay" />
      <VBox prefHeight="666.0" prefWidth="704.0" StackPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../assets/images/icon-logo-ludopatia.png" />
               </image>
            </ImageView>
            <Label styleClass="game-title" text="LUDOPATIA">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label styleClass="game-subtitle" text="A Epidemia das Apostas">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <VBox prefHeight="200.0" prefWidth="100.0" styleClass="login-card">
               <children>
                  <HBox onMouseClicked="#onIniciarButtonClicked" prefHeight="100.0" prefWidth="200.0" styleClass="option-box">
                     <children>
                        <ImageView fitHeight="47.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true" styleClass="option-icon">
                           <image>
                              <Image url="@../../assets/images/main-menu/icon-start.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="option-text" text="Iniciar Partida" />
                     </children>
                  </HBox>
                  <HBox onMouseClicked="#onSairButtonClicked" prefHeight="100.0" prefWidth="200.0" styleClass="option-box">
                     <children>
                        <ImageView fitHeight="48.0" fitWidth="53.0" pickOnBounds="true" preserveRatio="true" styleClass="option-icon">
                           <image>
                              <Image url="@../../assets/images/main-menu/icon-exit.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="option-text" text="Sair do Jogo" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <StackPane.margin>
            <Insets />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>
