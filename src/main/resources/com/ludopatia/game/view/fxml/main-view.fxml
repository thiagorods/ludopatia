<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="770.0" prefWidth="1366.0" styleClass="main-view" stylesheets="@../css/main-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ludopatia.game.controller.MainViewController">

   <!-- =====================================
        CABEÇALHO GLOBAL
        ===================================== -->

   <top>
      <StackPane styleClass="header-container">

         <HBox styleClass="header-content">

            <!-- Identidade do jogo -->
            <HBox styleClass="game-brand">
               <ImageView fitHeight="76.0" fitWidth="76.0" preserveRatio="true">
                  <image>
                     <Image url="@../../assets/images/icon-logo-ludopatia.png" />
                  </image>
               </ImageView>

               <VBox styleClass="brand-text">
                  <Label styleClass="brand-title" text="LUDOPATIA" />

                  <Label styleClass="brand-subtitle" text="A EPIDEMIA DAS APOSTAS" />
               </VBox>
            </HBox>

            <!-- Indicadores globais -->
            <HBox styleClass="global-statistics">

               <HBox styleClass="stat-item">
                  <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                     <image>
                        <Image url="@../../assets/images/icon-paises-infectados.png" />
                     </image>
                  </ImageView>

                  <VBox styleClass="stat-text">
                     <Label styleClass="stat-label" text="PAÍSES ATINGIDOS" />

                     <Label fx:id="countryReachedNumber" styleClass="stat-value" text="-" />
                  </VBox>
               </HBox>

               <Region styleClass="stat-separator" />

               <HBox styleClass="stat-item">
                  <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                     <image>
                        <Image url="@../../assets/images/icon-total-apostadores.png" />
                     </image>
                  </ImageView>

                  <VBox styleClass="stat-text">
                     <Label styleClass="stat-label" text="TOTAL DE APOSTADORES" />

                     <Label fx:id="totalPlayersNumber" styleClass="stat-value" text="-" />
                  </VBox>
               </HBox>
               <Region styleClass="stat-separator" />
               <HBox styleClass="stat-item">
                  <children>
                     <ImageView fitHeight="36.0" fitWidth="47.0" preserveRatio="true">
                        <image>
                           <Image url="@../../assets/images/icon-influencia.png" />
                        </image>
                     </ImageView>
                     <VBox styleClass="stat-text">
                        <children>
                           <Label styleClass="stat-label" text="INFLUÊNCIA" />
                           <Label fx:id="totalInfluenceNumber" styleClass="stat-value" text="-" />
                        </children>
                     </VBox>
                  </children>
               </HBox>

            </HBox>

            <!-- Espaçamento flexível -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Data do jogo -->
            <HBox styleClass="game-date">
               <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                  <image>
                     <Image url="@../../assets/images/icon-naipe-espadas-vermelho.png" />
                  </image>
               </ImageView>

               <VBox styleClass="date-text">
                  <Label styleClass="date-label" text="DIA ATUAL" />

                  <Label styleClass="date-value" text="01/01/2026" />
               </VBox>
            </HBox>

         </HBox>
      </StackPane>
   </top>

   <!-- =====================================
        ÁREA PRINCIPAL
        ===================================== -->

   <center>
      <StackPane styleClass="game-area">

         <!-- Fundo do mapa -->
         <Pane fx:id="mapContainer" styleClass="map-background" />

         <!-- Menu lateral -->
         <VBox fx:id="sideMenu" styleClass="side-menu" StackPane.alignment="TOP_LEFT">

            <StackPane.margin>
               <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </StackPane.margin>

            <HBox fx:id="sideMenuMapOption" onMouseClicked="#onMapaButtonClicked">
               <Label styleClass="menu-icon" text="◎" />
               <Label styleClass="menu-label" text="MAPA GLOBAL" />
               <styleClass>
                  <String fx:value="menu-option" />
                  <String fx:value="menu-option-active" />
               </styleClass>
            </HBox>

            <HBox fx:id="sideMenuStrategiesOption" onMouseClicked="#onEstrategiasButtonClicked" styleClass="menu-option">
               <Label styleClass="menu-icon" text="♠" />
               <Label styleClass="menu-label" text="ESTRATÉGIAS" />
            </HBox>

            <HBox fx:id="sideMenuResourcesOption" onMouseClicked="#onRecursosButtonClicked" styleClass="menu-option">
               <Label styleClass="menu-icon" text="♦" />
               <Label styleClass="menu-label" text="RECURSOS" />
            </HBox>

         </VBox>

         <!-- Painel de informações do país -->
         <VBox fx:id="countryPanel" managed="false" styleClass="country-panel" visible="false" StackPane.alignment="TOP_RIGHT">

            <StackPane.margin>
               <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </StackPane.margin>

            <Label styleClass="panel-title" text="PAÍS EM FOCO" />

            <Region styleClass="panel-divider" />

            <HBox styleClass="country-heading">
               <ImageView fx:id="countryFlag" fitHeight="28.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true" styleClass="country-flag">
                  <image>
                     <Image url="@../../assets/images/main/default-country.png" />
                  </image>
               </ImageView>
               <VBox>
                  <Label fx:id="countryName" styleClass="country-name" text="PAÍS" wrapText="true" />
                  <Label fx:id="countryStatus" styleClass="country-status" text="STATUS" />
               </VBox>
            </HBox>

            <Label fx:id="countryDescription" styleClass="country-description" text="Descrição do País" wrapText="true" />

            <Region styleClass="panel-divider" />

            <HBox styleClass="country-data-row">
               <Label text="POPULAÇÃO" />
               <Label fx:id="countryPopulation" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <Region styleClass="panel-divider" />

            <Label styleClass="section-label" text="ATRIBUTOS FIXOS" />

            <HBox styleClass="country-data-row">
               <Label text="Acessibilidade" />
               <Label fx:id="attrAcessibilidade" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Receptividade" />
               <Label fx:id="attrReceptividade" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Vulnerabilidade" />
               <Label fx:id="attrVulnerabilidade" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Resistência" />
               <Label fx:id="attrResistencia" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label styleClass="section-label" text="ATRIBUTOS DINÂMICOS" />

            <HBox styleClass="country-data-row">
               <Label text="Não Expostos" />
               <Label fx:id="dynNaoExpostos" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Expostos" />
               <Label fx:id="dynExpostos" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Jogadores" />
               <Label fx:id="dynJogadores" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Jogadores Recorrentes" />
               <Label fx:id="dynRecorrentes" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Jogadores em Risco" />
               <Label fx:id="dynEmRisco" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Recuperados" />
               <Label fx:id="dynRecuperados" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox styleClass="country-data-row">
               <Label text="Em Falência" />
               <Label fx:id="dynFalencia" maxWidth="Infinity" styleClass="data-value" text="—" HBox.hgrow="ALWAYS" />
            </HBox>

            <HBox fx:id="initialCountryOption" onMouseClicked="#onEscolherPaisInicialButtonClicked" styleClass="details-button">
               <Label text="ESCOLHER PAÍS" />
               <Label text="›" />
            </HBox>

         </VBox>

         <!-- Painel de notícias -->
         <VBox fx:id="newsPanel" alignment="CENTER_LEFT" styleClass="news-panel" StackPane.alignment="BOTTOM_RIGHT">

            <StackPane.margin>
               <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </StackPane.margin>

            <HBox styleClass="news-heading">
               <Region styleClass="news-accent" />
               <Label styleClass="news-title" text="ÚLTIMAS ATUALIZAÇÕES" />
            </HBox>

            <HBox styleClass="news-item">
               <Label styleClass="news-bullet" text="•" />
               <Label styleClass="news-text" text="Brasil teve aumento de 11,4% nos apostadores." HBox.hgrow="ALWAYS" />
               <Label styleClass="news-time" text="14:20" />
            </HBox>

            <HBox styleClass="news-item">
               <Label styleClass="news-bullet" text="•" />
               <Label styleClass="news-text" text="Nova casa de aposta ativada: Betano." HBox.hgrow="ALWAYS" />
               <Label styleClass="news-time" text="13:47" />
            </HBox>

            <HBox styleClass="news-item">
               <Label styleClass="news-bullet" text="•" />
               <Label styleClass="news-text" text="Alemanha registrou queda na taxa de infecção." HBox.hgrow="ALWAYS" />
               <Label styleClass="news-time" text="12:33" />
            </HBox>

         </VBox>

      </StackPane>
   </center>

</BorderPane>
